# Biến môi trường của agent (tiêu chí 9) — KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  rồi sửa giá trị (file .env đã nằm trong .gitignore)
PORT=8000
ENVIRONMENT=development
AGENT_API_KEY=replace-with-a-long-random-key
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
LOG_LEVEL=INFO
